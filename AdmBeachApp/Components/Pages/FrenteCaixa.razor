@page "/frente-caixa"
@using System.ComponentModel.DataAnnotations

<PageTitle>Frente de Caixa - AdmBeachApp</PageTitle>

<div class="container-fluid">
    <div class="row">
        <!-- Painel de Produtos -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">🏖️ Produtos Disponíveis</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var produto in produtos)
                        {
                            <div class="col-sm-6 col-md-4 col-lg-3 mb-3">
                                <div class="card h-100 produto-card" @onclick="() => AdicionarAoCarrinho(produto)">
                                    <div class="card-body text-center">
                                        <div class="produto-icon">@produto.Icone</div>
                                        <h6 class="card-title">@produto.Nome</h6>
                                        <p class="card-text text-success fw-bold">R$ @produto.Preco.ToString("F2")</p>
                                        <small class="text-muted">Estoque: @produto.Estoque</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Painel do Carrinho -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">🛒 Carrinho de Compras</h4>
                </div>
                <div class="card-body">
                    @if (itensCarrinho.Any())
                    {
                        <div class="carrinho-itens">
                            @foreach (var item in itensCarrinho)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2 p-2 border rounded">
                                    <div>
                                        <strong>@item.Produto.Nome</strong><br>
                                        <small>R$ @item.Produto.Preco.ToString("F2") x @item.Quantidade</small>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => DiminuirQuantidade(item)">
                                            <i class="oi oi-minus"></i>
                                        </button>
                                        <span class="mx-2">@item.Quantidade</span>
                                        <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => AumentarQuantidade(item)">
                                            <i class="oi oi-plus"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => RemoverDoCarrinho(item)">
                                            <i class="oi oi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <hr>
                        <div class="total-section">
                            <div class="d-flex justify-content-between">
                                <strong>Subtotal:</strong>
                                <strong>R$ @CalcularSubtotal().ToString("F2")</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Desconto:</span>
                                <span>R$ @desconto.ToString("F2")</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between">
                                <strong>Total:</strong>
                                <strong class="text-success">R$ @CalcularTotal().ToString("F2")</strong>
                            </div>
                        </div>

                        <!-- Forma de Pagamento -->
                        <div class="mt-3">
                            <label class="form-label">Forma de Pagamento:</label>
                            <select class="form-select" @bind="formaPagamento">
                                <option value="Dinheiro">💵 Dinheiro</option>
                                <option value="Cartão de Crédito">💳 Cartão de Crédito</option>
                                <option value="Cartão de Débito">💳 Cartão de Débito</option>
                                <option value="PIX">📱 PIX</option>
                            </select>
                        </div>

                        <div class="mt-3 d-grid gap-2">
                            <button class="btn btn-success btn-lg" @onclick="FinalizarVenda">
                                💰 Finalizar Venda
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="LimparCarrinho">
                                🗑️ Limpar Carrinho
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted">
                            <p>Carrinho vazio</p>
                            <p>Selecione produtos para adicionar</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Confirmação -->
@if (mostrarModalConfirmacao)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">✅ Venda Finalizada!</h5>
                </div>
                <div class="modal-body text-center">
                    <p>Venda realizada com sucesso!</p>
                    <p><strong>Total: R$ @ultimaVendaTotal.ToString("F2")</strong></p>
                    <p><strong>Forma de Pagamento: @ultimaVendaFormaPagamento</strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" @onclick="FecharModal">OK</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .produto-card {
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .produto-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }

    .produto-icon {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .carrinho-itens {
        max-height: 400px;
        overflow-y: auto;
    }

    .total-section {
        background-color: #f8f9fa;
        padding: 1rem;
        border-radius: 0.375rem;
    }
</style>

@code {
    private List<Produto> produtos = new();
    private List<ItemCarrinho> itensCarrinho = new();
    private string formaPagamento = "Dinheiro";
    private decimal desconto = 0;
    private bool mostrarModalConfirmacao = false;
    private decimal ultimaVendaTotal = 0;
    private string ultimaVendaFormaPagamento = "";

    protected override void OnInitialized()
    {
        CarregarProdutos();
    }

    private void CarregarProdutos()
    {
        produtos = new List<Produto>
        {
            new Produto { Id = 1, Nome = "Água Mineral", Preco = 3.00m, Estoque = 50, Icone = "💧" },
            new Produto { Id = 2, Nome = "Refrigerante", Preco = 5.50m, Estoque = 30, Icone = "🥤" },
            new Produto { Id = 3, Nome = "Cerveja", Preco = 8.00m, Estoque = 25, Icone = "🍺" },
            new Produto { Id = 4, Nome = "Sanduíche", Preco = 12.00m, Estoque = 15, Icone = "🥪" },
            new Produto { Id = 5, Nome = "Sorvete", Preco = 6.00m, Estoque = 20, Icone = "🍦" },
            new Produto { Id = 6, Nome = "Salgadinho", Preco = 4.50m, Estoque = 40, Icone = "🥨" },
            new Produto { Id = 7, Nome = "Açaí", Preco = 15.00m, Estoque = 10, Icone = "🍇" },
            new Produto { Id = 8, Nome = "Protetor Solar", Preco = 25.00m, Estoque = 12, Icone = "🧴" }
        };
    }

    private void AdicionarAoCarrinho(Produto produto)
    {
        if (produto.Estoque <= 0) return;

        var itemExistente = itensCarrinho.FirstOrDefault(i => i.Produto.Id == produto.Id);
        
        if (itemExistente != null)
        {
            if (itemExistente.Quantidade < produto.Estoque)
            {
                itemExistente.Quantidade++;
            }
        }
        else
        {
            itensCarrinho.Add(new ItemCarrinho { Produto = produto, Quantidade = 1 });
        }
        
        StateHasChanged();
    }

    private void AumentarQuantidade(ItemCarrinho item)
    {
        if (item.Quantidade < item.Produto.Estoque)
        {
            item.Quantidade++;
            StateHasChanged();
        }
    }

    private void DiminuirQuantidade(ItemCarrinho item)
    {
        if (item.Quantidade > 1)
        {
            item.Quantidade--;
        }
        else
        {
            RemoverDoCarrinho(item);
        }
        StateHasChanged();
    }

    private void RemoverDoCarrinho(ItemCarrinho item)
    {
        itensCarrinho.Remove(item);
        StateHasChanged();
    }

    private void LimparCarrinho()
    {
        itensCarrinho.Clear();
        StateHasChanged();
    }

    private decimal CalcularSubtotal()
    {
        return itensCarrinho.Sum(i => i.Produto.Preco * i.Quantidade);
    }

    private decimal CalcularTotal()
    {
        return CalcularSubtotal() - desconto;
    }

    private void FinalizarVenda()
    {
        if (!itensCarrinho.Any()) return;

        ultimaVendaTotal = CalcularTotal();
        ultimaVendaFormaPagamento = formaPagamento;
        
        // Simular atualização do estoque
        foreach (var item in itensCarrinho)
        {
            item.Produto.Estoque -= item.Quantidade;
        }
        
        // Limpar carrinho
        itensCarrinho.Clear();
        
        // Mostrar modal de confirmação
        mostrarModalConfirmacao = true;
        
        StateHasChanged();
    }

    private void FecharModal()
    {
        mostrarModalConfirmacao = false;
        StateHasChanged();
    }

    public class Produto
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public decimal Preco { get; set; }
        public int Estoque { get; set; }
        public string Icone { get; set; } = "";
    }

    public class ItemCarrinho
    {
        public Produto Produto { get; set; } = new();
        public int Quantidade { get; set; }
    }
}

