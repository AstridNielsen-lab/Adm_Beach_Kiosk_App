@page "/login"
@inject NavigationManager Navigation

<PageTitle>Login - AdmBeachApp</PageTitle>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0">🔐 Login AdmBeachApp</h4>
                </div>
                <div class="card-body">
                    @if (mostrarMensagem)
                    {
                        <div class="alert alert-@tipoMensagem alert-dismissible fade show" role="alert">
                            @mensagem
                            <button type="button" class="btn-close" @onclick="() => mostrarMensagem = false"></button>
                        </div>
                    }

                    <div class="mb-3">
                        <label for="usuario" class="form-label">Usuário:</label>
                        <input type="text" class="form-control" id="usuario" @bind="usuario" placeholder="Digite seu usuário">
                    </div>

                    <div class="mb-3">
                        <label for="senha" class="form-label">Senha:</label>
                        <input type="password" class="form-control" id="senha" @bind="senha" placeholder="Digite sua senha">
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg" @onclick="FazerLogin" disabled="@fazendoLogin">
                            @if (fazendoLogin)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Entrando...</span>
                            }
                            else
                            {
                                <span>🔑 Entrar</span>
                            }
                        </button>
                        
                        <button class="btn btn-success" @onclick="LoginDemo">
                            🎮 Login Demo (Sem autenticação)
                        </button>
                    </div>

                    <hr>
                    
                    <div class="text-center">
                        <small class="text-muted">
                            Para teste rápido, use o Login Demo<br>
                            Usuário: <strong>admin</strong> | Senha: <strong>123456</strong>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string usuario = "";
    private string senha = "";
    private bool fazendoLogin = false;
    private bool mostrarMensagem = false;
    private string mensagem = "";
    private string tipoMensagem = "info";

    private async Task FazerLogin()
    {
        if (string.IsNullOrWhiteSpace(usuario) || string.IsNullOrWhiteSpace(senha))
        {
            ExibirMensagem("Por favor, preencha usuário e senha.", "warning");
            return;
        }

        fazendoLogin = true;
        StateHasChanged();

        // Simular delay de autenticação
        await Task.Delay(1500);

        // Verificar credenciais simples para demo
        if (usuario.ToLower() == "admin" && senha == "123456")
        {
            ExibirMensagem("Login realizado com sucesso!", "success");
            await Task.Delay(1000);
            Navigation.NavigateTo("/frente-caixa");
        }
        else
        {
            ExibirMensagem("Usuário ou senha incorretos.", "danger");
        }

        fazendoLogin = false;
        StateHasChanged();
    }

    private void LoginDemo()
    {
        ExibirMensagem("Entrando no modo demo...", "info");
        Task.Delay(500).ContinueWith(_ => Navigation.NavigateTo("/frente-caixa"));
    }

    private void ExibirMensagem(string msg, string tipo)
    {
        mensagem = msg;
        tipoMensagem = tipo;
        mostrarMensagem = true;
        StateHasChanged();
    }
}
